# Copiar a apps/api/.env y apps/web/.env.local. Nunca versionar los valores reales.

# --- API ---
DATABASE_URL=postgresql://gm:gm_local_only@localhost:5432/gestion_muestras?schema=public
PORT=8080
TZ_NEGOCIO=America/Santiago
# Proyecto de Google Identity Platform / Firebase (verificación de JWT)
FIREBASE_PROJECT_ID=gm-dev
# Solo en desarrollo local: acepta un token de prueba "dev:<rol>:<codemp>:<rutcon|idusr>"
AUTH_DEV_BYPASS=true
# Indicadores de funcionalidad (valores por defecto; se sobrescriben por empresa en PARAMETRO)
FEATURE_DEDUPLICACION=true
FEATURE_PENDIENTES_ENTREGA=false

# --- WEB ---
# VITE_API_URL vacío en desarrollo: el proxy de Vite reenvía /v1 a http://localhost:8080
VITE_API_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=gm-dev
