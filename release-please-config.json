{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    { "type": "feat", "section": "Funcionalidades" },
    { "type": "fix", "section": "Correcciones" },
    { "type": "perf", "section": "Rendimiento" },
    { "type": "refactor", "section": "Refactorización", "hidden": false },
    { "type": "docs", "section": "Documentación", "hidden": false },
    { "type": "chore", "section": "Mantenimiento", "hidden": true },
    { "type": "ci", "section": "Integración continua", "hidden": true },
    { "type": "test", "section": "Pruebas", "hidden": true }
  ],
  "packages": {
    "apps/api": { "release-type": "node", "component": "api" },
    "apps/web": { "release-type": "node", "component": "web" },
    "packages/domain": { "release-type": "node", "component": "domain" },
    "apps/mobile": {
      "release-type": "dart",
      "component": "mobile",
      "extra-files": [{ "type": "generic", "path": "pubspec.yaml" }]
    }
  },
  "plugins": [{ "type": "node-workspace", "merge": false }]
}
